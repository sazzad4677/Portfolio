
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# ─── FALLBACK: OpenRouter free tier ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─── Site URL (for SEO/Sitemap and AI gateway referer header) ─────────────────
NEXT_PUBLIC_SITE_URL=https://sazzad.dev

# ─── Chat rate limiting + reply cache (Upstash Redis) ─────────────────────────
# Set automatically by the Vercel Marketplace Upstash integration. When unset,
# rate limits are skipped and replies are cached per-isolate in memory.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-upstash-token

# ─── Contact form (Formspree) ─────────────────────────────────────────────────
NEXT_PUBLIC_FORMSPREE_ID=your-formspree-form-id
